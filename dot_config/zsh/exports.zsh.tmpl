# ------------------------------------------------------------------------------
# Zsh 环境变量导出配置模板
# 由 chezmoi 托管 | DevSecOps 生产级 Profile
# ------------------------------------------------------------------------------

# --- 1. 全局 PATH 环境变量设置 ---
typeset -U path
path=(
{{- if .is_mac }}
    /opt/homebrew/bin
    /opt/homebrew/sbin
{{- else if .is_linux }}
    /home/linuxbrew/.linuxbrew/bin
    /home/linuxbrew/.linuxbrew/sbin
{{- end }}
    $HOME/.cargo/bin
    $HOME/.local/bin
    $HOME/go/bin
    $HOME/.local/share/mise/shims   # mise 运行时shims (多语言版本管理器)
    $path
)
export PATH

# --- 2. 默认编辑器与 Pager 分页器 ---
export EDITOR="{{ .git.editor }}"
export VISUAL="{{ .git.editor }}"
export PAGER="less -RF"
export LANG="en_US.UTF-8"

# --- 3. 硬件编译加速旗标 ---
{{- if and .is_mac .is_arm64 }}
# 针对 macOS Apple Silicon 架构进行编译指令集原生优化
export RUSTFLAGS="-C target-cpu=native"
export ZIG_FLAGS="-mcpu=native"
export CFLAGS="-march=native"
export CXXFLAGS="-march=native"
{{- end }}

# --- 4. 工具链与主题环境变量 ---
export CARGO_HOME="$HOME/.cargo"
export GOPATH="$HOME/go"
export UV_PYTHON_PREFERENCE="managed"
export BAT_THEME="Catppuccin Mocha"

# --- 5. FZF 配色主题配置 (Catppuccin Mocha 调色板) ---
export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border \
  --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 \
  --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc \
  --color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8"
