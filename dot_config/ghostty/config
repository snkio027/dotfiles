# ------------------------------------------------------------------------------
# Ghostty GPU 加速原生终端模拟器配置文件
# DevSecOps 生产级 Profile
# ------------------------------------------------------------------------------

# 外观样式与色彩主题
theme = "Catppuccin Mocha"
font-family = "JetBrainsMono Nerd Font"
font-size = 14
# 开启 JetBrains Mono 字体特性 (例如 zero 渲染带斜杠的 0，彻底防与大写 O 混淆)
font-feature = ["zero", "ss01", "ss02"]
window-padding-x = 12
window-padding-y = 12
window-decoration = true
window-title-font-family = "Inter"
unfocused-split-opacity = 0.7

# 窗口行为与光标样式
macos-titlebar-style = transparent
window-height = 40
window-width = 130
cursor-style = block

# 鼠标交互与历史回溯缓冲区
focus-follows-mouse = true
mouse-hide-while-typing = true
scrollback-limit = 100000
selection-word-chars = "/\\_-.~:?=&"

# 剪贴板复制与关闭确认
copy-on-select = true
confirm-close-surface = false

# ------------------------------------------------------------------------------
# 现代工作站高阶交互配置
# ------------------------------------------------------------------------------

# 1. 长时间后台任务完成系统通知 (超过 15 秒且非聚焦状态下自动触发 macOS 通知)
notify-on-command-finish = unfocused
notify-on-command-finish-after = 15s
notify-on-command-finish-action = notify

# 2. 全局下拉式终端 (Quake Mode: Cmd+Alt+Space 瞬间唤出隐藏终端)
keybind = global:cmd+alt+space=toggle_quick_terminal

# 3. 分屏管理与 Vim 风格焦点切换快捷键
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+h=goto_split:left
keybind = super+l=goto_split:right
keybind = super+k=goto_split:up
keybind = super+j=goto_split:down
keybind = super+z=toggle_split_zoom
