// ------------------------------------------------------------------------------
// Zellij 终端工作区复用器配置文件
// DevSecOps 生产级 Profile | 免前缀 Vim 盲操与 Catppuccin Mocha 原生主题
// ------------------------------------------------------------------------------

theme "catppuccin-mocha"
default_layout "compact"
mouse_mode true
copy_on_select true
pane_frames true
simplified_ui false

ui {
    pane_frames {
        rounded_corners true
        hide_session_name false
    }
}

// 嵌合式 Catppuccin Mocha 主题调色板
themes {
    catppuccin-mocha {
        bg "#585b70"
        fg "#cdd6f4"
        red "#f38ba8"
        green "#a6e3a1"
        yellow "#f9e2af"
        blue "#89b4fa"
        magenta "#cba6f7"
        cyan "#94e2d5"
        white "#bac2de"
        orange "#fab387"
        black "#181825"
    }
}

// 免前缀模式 Vim 风格分屏盲操导航与悬浮面板
keybinds {
    normal {
        bind "Alt h" { MoveFocus "Left"; }
        bind "Alt l" { MoveFocus "Right"; }
        bind "Alt j" { MoveFocus "Down"; }
        bind "Alt k" { MoveFocus "Up"; }
        bind "Alt n" { NewPane; }
        bind "Alt x" { CloseFocus; }
        bind "Alt f" { ToggleFocusFullscreen; }
        bind "Alt i" { ToggleFloatingPanes; } // 瞬间弹出/隐藏悬浮工作面板
        bind "Alt t" { NewTab; }
        bind "Alt [" { GoToPreviousTab; }
        bind "Alt ]" { GoToNextTab; }
    }
}
