{
  "name": "DevSecOps Personal Workstation",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "containerEnv": {
    "CHEZMOI_PROFILE": "devcontainer"
  },
  "remoteUser": "vscode",
  "postCreateCommand": "GIT_AUTHOR_NAME=\"${GIT_AUTHOR_NAME:-Dev Container}\" GIT_AUTHOR_EMAIL=\"${GIT_AUTHOR_EMAIL:-devcontainer@localhost}\" chezmoi init --apply --source=/workspaces/dotfiles"
}
