#!/usr/bin/env bash
# ------------------------------------------------------------------------------
# run_onchange_after_50_install_git_hooks.sh.tmpl
# DevSecOps 自动防御：为本地 Git 仓库一键自动注入 gitleaks pre-commit 钩子
# ------------------------------------------------------------------------------

set -euo pipefail

if command -v gitleaks &>/dev/null; then
    # 检查当前 dotfiles 源码仓库是否有 .git 目录
    HOOK_FILE="{{ .chezmoi.sourceDir }}/.git/hooks/pre-commit"
    if [ -d "{{ .chezmoi.sourceDir }}/.git" ] && [ -d "{{ .chezmoi.sourceDir }}/.git/hooks" ]; then
        echo "🔒  正在挂载 gitleaks pre-commit 提交拦截钩子..."
        cat << 'EOF' > "$HOOK_FILE"
#!/usr/bin/env bash
# Managed by chezmoi
if command -v gitleaks &>/dev/null; then
    gitleaks protect --staged --verbose
fi
EOF
        chmod +x "$HOOK_FILE"
        echo "✅  gitleaks pre-commit 钩子注入完成。"
    fi
fi
