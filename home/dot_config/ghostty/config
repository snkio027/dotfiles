# ------------------------------------------------------------------------------
# Ghostty macOS GPU 加速原生终端模拟器配置文件
# Cmd 快捷键与 global 前缀均属于 macOS 宿主层；终端内 Alt 由左 Option 提供。
# ------------------------------------------------------------------------------

# 1. 外观样式与色彩主题
# Always use the dark palette, independent of the macOS appearance setting.
theme = "Catppuccin Mocha"
# Independent fallback layers keep code, CJK, and private-use icons diagnosable
# without patching the licensed MonoLisa font files.
font-family = "MonoLisaCode Variable-cv04-cv08-ss03-ss07-ss11"
font-family = "PingFang SC"
font-family = "Maple Mono NF CN"
font-family = "Symbols Nerd Font Mono"
font-style = "Regular"
font-style-bold = "Regular"
font-style-italic = "Italic"
font-style-bold-italic = "Italic"
font-synthetic-style = false
font-variation = "wght=600"
font-variation = "GRAD=25"
font-variation-bold = "wght=800"
font-variation-bold = "GRAD=25"
font-variation-italic = "wght=600"
font-variation-italic = "GRAD=25"
font-variation-bold-italic = "wght=800"
font-variation-bold-italic = "GRAD=25"
font-size = 14
font-thicken = false
# MonoLisa OpenType preferences are compiled into the licensed font build.
# Ghostty 1.3 applies font-feature globally, so do not set it on this fallback stack.
minimum-contrast = 3

# 玻璃透明度与阴影效果
background-opacity = 0.96
background-blur-radius = 12

window-padding-x = 14
window-padding-y = 14
window-decoration = true
window-title-font-family = "MonoLisaCode Variable-cv04-cv08-ss03-ss07-ss11"
unfocused-split-opacity = 0.75

# 2. 窗口行为与光标样式
macos-titlebar-style = transparent
macos-titlebar-proxy-icon = hidden
window-height = 42
window-width = 135
cursor-style = block
cursor-style-blink = false

# 左 Option 作为 Alt/Meta，保留 Zsh 的单词级移动。
macos-option-as-alt = left

# 3. 鼠标交互与剪贴板
focus-follows-mouse = true
mouse-hide-while-typing = true
scrollback-limit = 100000
copy-on-select = true
clipboard-read = ask
clipboard-write = allow
confirm-close-surface = true

# 4. 后台任务完成系统通知 (运行 >15s 且非当前窗口焦点时弹窗通知)
notify-on-command-finish = unfocused
notify-on-command-finish-after = 15s
notify-on-command-finish-action = notify

# 5. macOS 全局下拉快捷终端 (Quake Mode: Cmd+左 Option+Space)
keybind = global:cmd+alt+space=toggle_quick_terminal

# 6. macOS 分屏管理与 Vim 风格焦点切换快捷键
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+h=goto_split:left
keybind = cmd+l=goto_split:right
keybind = cmd+k=goto_split:up
keybind = cmd+j=goto_split:down
keybind = cmd+z=toggle_split_zoom
