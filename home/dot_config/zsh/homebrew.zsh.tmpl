# ------------------------------------------------------------------------------
# Homebrew / Linuxbrew environment owner
# Fixed platform paths keep Shell startup deterministic and avoid `brew` subprocesses.
# This file is safe to source from both .zprofile and .zshrc.
# ------------------------------------------------------------------------------

{{- if .is_mac }}
{{- if .is_arm64 }}
typeset -gx HOMEBREW_PREFIX="/opt/homebrew"
{{- else }}
typeset -gx HOMEBREW_PREFIX="/usr/local"
{{- end }}
{{- else if .is_linux }}
typeset -gx HOMEBREW_PREFIX="/home/linuxbrew/.linuxbrew"
{{- end }}
typeset -gx HOMEBREW_CELLAR="$HOMEBREW_PREFIX/Cellar"
typeset -gx HOMEBREW_REPOSITORY="$HOMEBREW_PREFIX"
# Share one checkout across shells; an explicit project/custom root always wins.
typeset -gx VCPKG_ROOT="${VCPKG_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/vcpkg}"

# Zsh's tied arrays update PATH and FPATH without string splitting. This is the
# only managed PATH owner; the unique attribute makes repeated sourcing
# idempotent while preserving first priority.
typeset -gU path fpath

{{- if .is_linux }}
# A Linux shell inherited from a long-lived cross-platform host must never
# retain Apple Silicon Homebrew locations.
path=("${(@)path:#/opt/homebrew}")
path=("${(@)path:#/opt/homebrew/*}")
fpath=("${(@)fpath:#/opt/homebrew}")
fpath=("${(@)fpath:#/opt/homebrew/*}")
{{- end }}
# Normalize managed global tools before system paths (including /usr/local on
# Apple Silicon). Keep project shims ahead of them; path_helper may have moved
# an active venv/Conda bin behind system directories in a nested login shell.
() {
    local entry
    local -a globals=(
        "$HOMEBREW_PREFIX/opt/rustup/bin"
        "$HOMEBREW_PREFIX/opt/llvm/bin"
        "$HOMEBREW_PREFIX/bin"
        # Fallback for a versioned Python keg without a public python3 link.
        "$HOMEBREW_PREFIX/opt/python@3/libexec/bin"
        "$HOMEBREW_PREFIX/sbin"
    ) defaults=(
        "${CARGO_HOME:-$HOME/.cargo}/bin"
        "$HOME/.local/bin"
        "$VCPKG_ROOT"
    ) missing=() context=() remaining=() ordered=()
    for entry in "${(@s/:/)${GOPATH:-$HOME/go}}"; do
        defaults+=("$entry/bin")
    done
    for entry in "${defaults[@]}"; do
        (( ${path[(Ie)$entry]} )) || missing+=("$entry")
    done
    for entry in "${path[@]}"; do
        if [[ ( -n "${VIRTUAL_ENV:-}" && "$entry" == "$VIRTUAL_ENV/bin" ) ||
              ( -n "${CONDA_PREFIX:-}" && "$entry" == "$CONDA_PREFIX/bin" ) ]]; then
            context+=("$entry")
        elif (( ! ${globals[(Ie)$entry]} )); then
            remaining+=("$entry")
        fi
    done
    local insert_globals
    for entry in "${remaining[@]}"; do
        insert_globals=false
        case "$entry" in
            /usr/local/bin|/usr/local/sbin|/usr/bin|/bin|/usr/sbin|/sbin|/System/Cryptexes/App/usr/bin)
                insert_globals=true ;;
        esac
        (( ${defaults[(Ie)$entry]} )) && insert_globals=true
        if [[ "$insert_globals" == true ]]; then
            ordered+=("${globals[@]}" "${missing[@]}")
            globals=() missing=()
        fi
        ordered+=("$entry")
    done
    path=("${context[@]}" "${ordered[@]}" "${globals[@]}" "${missing[@]}")
}
fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
export PATH FPATH

typeset -gaU _dotfiles_homebrew_infopath
_dotfiles_homebrew_infopath=(
    "$HOMEBREW_PREFIX/share/info"
    ${(@s/:/)${INFOPATH:-}}
)
typeset -gx INFOPATH="${(j/:/)_dotfiles_homebrew_infopath}"
unset _dotfiles_homebrew_infopath
