#!/usr/bin/env bash
# ==============================================================================
# doctor.sh — Executable Personal Developer Platform Health Diagnostics
# DevSecOps Grade Platform Engineering Tool | Chezmoi Integrated
# ==============================================================================

set -euo pipefail

# ANSI Color Definitions
BOLD="\033[1m"
RED="\033[31m"
GREEN="\033[32m"
YELLOW="\033[33m"
BLUE="\033[34m"
CYAN="\033[36m"
RESET="\033[0m"

PASS="${GREEN}✓${RESET}"
WARN="${YELLOW}⚠${RESET}"
FAIL="${RED}✕${RESET}"

TOTAL_CHECKS=0
PASSED_CHECKS=0
WARN_CHECKS=0
FAIL_CHECKS=0

check_status() {
    local name="$1"
    local status="$2"
    local detail="${3:-}"

    TOTAL_CHECKS=$((TOTAL_CHECKS + 1))
    case "$status" in
        pass)
            PASSED_CHECKS=$((PASSED_CHECKS + 1))
            printf "  %-30s %b %s\n" "$name" "$PASS" "$detail"
            ;;
        warn)
            WARN_CHECKS=$((WARN_CHECKS + 1))
            printf "  %-30s %b %s\n" "$name" "$WARN" "$detail"
            ;;
        fail)
            FAIL_CHECKS=$((FAIL_CHECKS + 1))
            printf "  %-30s %b %s\n" "$name" "$FAIL" "$detail"
            ;;
    esac
}

# Capture the command before formatting: pipelines/fallback text must not turn
# an unusable executable into a successful health check (or hide stderr).
observe_version() {
    local output status
    if output="$("$@" 2>&1)"; then
        if [[ "$output" != *[![:space:]]* ]]; then
            VERSION_DETAIL="empty version response"
            return 1
        fi
        VERSION_DETAIL="${output%%$'\n'*}"
        return 0
    else
        status=$?
        VERSION_DETAIL="version command failed, exit $status: $output"
        return 1
    fi
}

check_version() {
    local name="$1" missing_status="$2"
    shift 2
    if ! command -v "$1" &>/dev/null; then
        check_status "$name" "$missing_status" "$1 missing in PATH"
    elif observe_version "$@"; then
        check_status "$name" "pass" "$VERSION_DETAIL"
    else
        check_status "$name" "fail" "$VERSION_DETAIL"
    fi
}

echo -e "${BOLD}${CYAN}======================================================================${RESET}"
echo -e "${BOLD}${CYAN}   🚀 Developer Platform Environment Health Check (devdoctor)   ${RESET}"
echo -e "${BOLD}${CYAN}======================================================================${RESET}"
echo ""

# ------------------------------------------------------------------------------
# 1. System & Core Infrastructure
# ------------------------------------------------------------------------------
echo -e "${BOLD}${BLUE}[1/5] System & Core Infrastructure${RESET}"

OS_TYPE="$(uname -s)"
ARCH_TYPE="$(uname -m)"
check_status "Operating System" "pass" "$OS_TYPE ($ARCH_TYPE)"

check_version "Homebrew Package Manager" "fail" brew --version
if command -v brew &>/dev/null; then
    BREW_PREFIX="$(brew --prefix 2>/dev/null || true)"
else
    BREW_PREFIX=""
fi

if command -v chezmoi &>/dev/null; then
    if ! observe_version chezmoi --version; then
        check_status "chezmoi State" "fail" "$VERSION_DETAIL"
    elif RAW_STATUS="$(chezmoi status)"; then
        FILE_DIFFS=0
        PENDING_SCRIPTS=0
        while IFS= read -r status_line; do
            [[ -n "$status_line" ]] || continue
            # Read the two status columns, not words in a possibly spaced path.
            if [[ "${status_line:0:2}" == ' R' ]]; then
                PENDING_SCRIPTS=$((PENDING_SCRIPTS + 1))
            else
                FILE_DIFFS=$((FILE_DIFFS + 1))
            fi
        done <<<"$RAW_STATUS"
        if [ "$FILE_DIFFS" -eq 0 ]; then
            check_status "chezmoi Files" "pass" "$VERSION_DETAIL (0 file differences; Synced / Clean)"
        else
            check_status "chezmoi Files" "warn" "$VERSION_DETAIL ($FILE_DIFFS file differences)"
        fi
        if [ "$PENDING_SCRIPTS" -eq 0 ]; then
            check_status "chezmoi Scripts" "pass" "0 pending scripts"
        else
            check_status "chezmoi Scripts" "warn" "$PENDING_SCRIPTS pending scripts; not executed (review before apply)"
        fi
    else
        STATUS_EXIT=$?
        check_status "chezmoi State" "fail" "$VERSION_DETAIL (status failed, exit $STATUS_EXIT)"
    fi
else
    check_status "chezmoi State" "fail" "chezmoi binary missing"
fi

check_version "age Encryption CLI" "warn" age --version

echo ""

# ------------------------------------------------------------------------------
# 2. Security & Credentials Plane
# ------------------------------------------------------------------------------
echo -e "${BOLD}${BLUE}[2/5] Security & Credentials Plane${RESET}"

{{- if .features.use_1password }}
if [ -n "${OP_SSH_AUTH_SOCK:-}" ]; then
    OP_SOCK="$OP_SSH_AUTH_SOCK"
elif [ "$OS_TYPE" = "Darwin" ]; then
    OP_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
else
    OP_SOCK="$HOME/.1password/agent.sock"
fi

if [ -S "$OP_SOCK" ]; then
    check_status "1Password SSH Agent" "pass" "Socket active ($OP_SOCK)"
else
    check_status "1Password SSH Agent" "warn" "Socket not detected ($OP_SOCK)"
fi
{{- end }}

{{- if eq .machine_profile "devcontainer" }}
check_status "Git SSH Signing" "pass" "Disabled by devcontainer profile"
{{- else }}
if [ -f "$HOME/.ssh/keys/git_signing.pub" ]; then
    check_status "Git SSH Signing Key" "pass" "$HOME/.ssh/keys/git_signing.pub ready"
else
    check_status "Git SSH Signing Key" "warn" "Signing public key missing (run chezmoi scripts)"
fi

if [ -f "$HOME/.ssh/allowed_signers" ]; then
    check_status "SSH Allowed Signers" "pass" "$HOME/.ssh/allowed_signers configured"
else
    check_status "SSH Allowed Signers" "warn" "$HOME/.ssh/allowed_signers missing"
fi
{{- end }}

check_version "gitleaks Scanner" "warn" gitleaks version

echo ""

# ------------------------------------------------------------------------------
# 3. Runtime & Platform Toolchain
# ------------------------------------------------------------------------------
echo -e "${BOLD}${BLUE}[3/5] Runtime & Platform Toolchain${RESET}"

check_version "uv Python Manager" "warn" uv --version
check_version "Python Environment" "warn" python3 --version
check_version "Node.js Environment" "warn" node --version

RUSTUP_BIN="$BREW_PREFIX/opt/rustup/bin/rustup"
if [ -x "$RUSTUP_BIN" ] &&
    RUST_ACTIVE="$(RUSTUP_AUTO_INSTALL=0 "$RUSTUP_BIN" show active-toolchain 2>/dev/null)" &&
    RUST_REAL="$(RUSTUP_AUTO_INSTALL=0 "$RUSTUP_BIN" which rustc 2>/dev/null)" &&
    CARGO_REAL="$(RUSTUP_AUTO_INSTALL=0 "$RUSTUP_BIN" which cargo 2>/dev/null)" &&
    RUST_VER="$(RUSTUP_AUTO_INSTALL=0 rustc --version 2>/dev/null)" &&
    CARGO_VER="$(RUSTUP_AUTO_INSTALL=0 cargo --version 2>/dev/null)"; then
    rust_path="$(command -v rustc)"
    cargo_path="$(command -v cargo)"
    if [[ ("$rust_path" == "${RUSTUP_BIN%/*}/rustc" || "$rust_path" == "$RUST_REAL") &&
        ("$cargo_path" == "${RUSTUP_BIN%/*}/cargo" || "$cargo_path" == "$CARGO_REAL") ]]; then
        check_status "Rust Toolchain (rustup)" "pass" "$RUST_VER; $CARGO_VER; $RUST_ACTIVE"
    else
        check_status "Rust Toolchain (rustup)" "warn" "PATH selects $rust_path / $cargo_path; expected rustup or its selected toolchain"
    fi
else
    check_status "Rust Toolchain (rustup)" "warn" "Manager/toolchain missing or unusable; no automatic installation attempted"
fi

check_version "Go Toolchain" "warn" go version
check_version "Zig Toolchain" "warn" zig version
check_version "LLVM C/C++ Toolchain" "warn" clang --version
check_version "CMake Build System" "warn" cmake --version
check_version "Ninja Build Backend" "warn" ninja --version
check_version "C/C++ Compiler Cache" "warn" ccache --version
check_version "C++ Project Initializer" "warn" cxx --version

# Check the same root CMake consumes, not an unrelated vcpkg found on PATH.
if [[ -z "${VCPKG_ROOT:-}" ]]; then
    check_status "C++ Dependencies (vcpkg)" "warn" "VCPKG_ROOT unset; open a new managed Shell or configure your existing checkout"
elif [[ ! -f "$VCPKG_ROOT/scripts/buildsystems/vcpkg.cmake" || ! -x "$VCPKG_ROOT/vcpkg" ]]; then
    check_status "C++ Dependencies (vcpkg)" "warn" "Incomplete checkout: $VCPKG_ROOT; see the vcpkg setup in docs/operations.md"
elif VCPKG_VERSION="$(VCPKG_DISABLE_METRICS=1 "$VCPKG_ROOT/vcpkg" version 2>&1)"; then
    check_status "C++ Dependencies (vcpkg)" "pass" "$VCPKG_ROOT: ${VCPKG_VERSION%%$'\n'*}"
else
    check_status "C++ Dependencies (vcpkg)" "warn" "vcpkg failed at $VCPKG_ROOT: $VCPKG_VERSION"
fi

check_version "Terraform CLI" "warn" terraform version
check_version "Kubernetes CLI" "warn" kubectl version --client
check_version "Helm CLI" "warn" helm version --short

RUNTIME_OUTSIDE=()
if [ -z "$BREW_PREFIX" ]; then
    RUNTIME_OUTSIDE+=("Homebrew prefix unavailable")
else
    for tool in uv python3 node go zig clang cmake ninja ccache terraform kubectl helm; do
        tool_path="$(command -v "$tool" 2>/dev/null || true)"
        case "$tool_path" in
            "$BREW_PREFIX"/*) ;;
            *) RUNTIME_OUTSIDE+=("$tool=${tool_path:-missing}") ;;
        esac
    done
fi
if [ "${#RUNTIME_OUTSIDE[@]}" -eq 0 ]; then
    check_status "Runtime Ownership" "pass" "Non-Rust runtimes resolve from $BREW_PREFIX; Rust checked separately"
else
    check_status "Runtime Ownership" "warn" "Outside Homebrew (may be project overrides): ${RUNTIME_OUTSIDE[*]}"
fi

echo ""

# ------------------------------------------------------------------------------
# 4. Productivity & Terminal Environment
# ------------------------------------------------------------------------------
echo -e "${BOLD}${BLUE}[4/5] Productivity & Terminal Suite${RESET}"

for tool in starship atuin zoxide yazi lazygit zellij nvim carapace; do
    if command -v "$tool" &>/dev/null; then
        check_status "$tool" "pass" "installed"
    else
        check_status "$tool" "warn" "missing in PATH"
    fi
done

if [ "$OS_TYPE" = "Darwin" ]; then
    if command -v ghostty &>/dev/null || [ -d "/Applications/Ghostty.app" ] || [ -d "$HOME/Applications/Ghostty.app" ]; then
        check_status "ghostty" "pass" "installed"
    else
        check_status "ghostty" "warn" "application not found"
    fi
fi

echo ""

# ------------------------------------------------------------------------------
# 5. Summary & Health Report
# ------------------------------------------------------------------------------
echo -e "${BOLD}${BLUE}[5/5] Diagnostic Summary${RESET}"
echo -e "  Total Checks : $TOTAL_CHECKS"
echo -e "  Passed       : ${GREEN}$PASSED_CHECKS${RESET}"
echo -e "  Warnings     : ${YELLOW}$WARN_CHECKS${RESET}"
echo -e "  Failures     : ${RED}$FAIL_CHECKS${RESET}"
echo ""

if [ "$FAIL_CHECKS" -eq 0 ] && [ "$WARN_CHECKS" -eq 0 ]; then
    echo -e "${BOLD}${GREEN}🎉 Platform status: 100% Healthy! Environment is in peak DevEx state.${RESET}"
elif [ "$FAIL_CHECKS" -eq 0 ]; then
    echo -e "${BOLD}${YELLOW}⚡ Platform status: Good with minor warnings. Review the items above.${RESET}"
else
    echo -e "${BOLD}${RED}🚨 Platform status: Needs attention. Please fix failed items above.${RESET}"
fi
echo -e "${BOLD}${CYAN}======================================================================${RESET}"

if [ "$FAIL_CHECKS" -gt 0 ]; then
    exit 1
fi
