#!/usr/bin/env bash
# ==============================================================================
# doctor.sh — Executable Personal Developer Platform Health Diagnostics
# DevSecOps Grade Platform Engineering Tool | Chezmoi Integrated
# ==============================================================================

set -euo pipefail

# ANSI Color Definitions
BOLD="\033[1m"
RED="\033[31m"
GREEN="\033[32m"
YELLOW="\033[33m"
BLUE="\033[34m"
CYAN="\033[36m"
RESET="\033[0m"

PASS="${GREEN}✓${RESET}"
WARN="${YELLOW}⚠${RESET}"
FAIL="${RED}✕${RESET}"

TOTAL_CHECKS=0
PASSED_CHECKS=0
WARN_CHECKS=0
FAIL_CHECKS=0

check_status() {
    local name="$1"
    local status="$2"
    local detail="${3:-}"

    TOTAL_CHECKS=$((TOTAL_CHECKS + 1))
    case "$status" in
        pass)
            PASSED_CHECKS=$((PASSED_CHECKS + 1))
            printf "  %-30s %b %s\n" "$name" "$PASS" "$detail"
            ;;
        warn)
            WARN_CHECKS=$((WARN_CHECKS + 1))
            printf "  %-30s %b %s\n" "$name" "$WARN" "$detail"
            ;;
        fail)
            FAIL_CHECKS=$((FAIL_CHECKS + 1))
            printf "  %-30s %b %s\n" "$name" "$FAIL" "$detail"
            ;;
    esac
}

echo -e "${BOLD}${CYAN}======================================================================${RESET}"
echo -e "${BOLD}${CYAN}   🚀 Developer Platform Environment Health Check (devdoctor)   ${RESET}"
echo -e "${BOLD}${CYAN}======================================================================${RESET}"
echo ""

# ------------------------------------------------------------------------------
# 1. System & Core Infrastructure
# ------------------------------------------------------------------------------
echo -e "${BOLD}${BLUE}[1/5] System & Core Infrastructure${RESET}"

OS_TYPE="$(uname -s)"
ARCH_TYPE="$(uname -m)"
check_status "Operating System" "pass" "$OS_TYPE ($ARCH_TYPE)"

if command -v brew &>/dev/null; then
    BREW_VER="$(brew --version 2>/dev/null | head -n1 || echo "installed")"
    BREW_PREFIX="$(brew --prefix 2>/dev/null || true)"
    check_status "Homebrew Package Manager" "pass" "$BREW_VER"
else
    BREW_PREFIX=""
    check_status "Homebrew Package Manager" "fail" "Not installed in PATH"
fi

if command -v chezmoi &>/dev/null; then
    CZ_VER="$(chezmoi --version 2>/dev/null | sed -E 's/^chezmoi version ([^,]+).*/\1/' | head -n1 || echo "installed")"
    RAW_STATUS="$(chezmoi status 2>/dev/null || true)"
    if [ -z "$RAW_STATUS" ]; then
        check_status "chezmoi State" "pass" "$CZ_VER (Synced / Clean)"
    else
        DIFF_COUNT="$(echo "$RAW_STATUS" | wc -l | tr -d ' ')"
        check_status "chezmoi State" "warn" "$CZ_VER ($DIFF_COUNT pending diffs)"
    fi
else
    check_status "chezmoi State" "fail" "chezmoi binary missing"
fi

if command -v age &>/dev/null; then
    AGE_VER="$(age --version 2>/dev/null | head -n1 || echo "installed")"
    check_status "age Encryption CLI" "pass" "$AGE_VER"
else
    check_status "age Encryption CLI" "warn" "age binary missing"
fi

echo ""

# ------------------------------------------------------------------------------
# 2. Security & Credentials Plane
# ------------------------------------------------------------------------------
echo -e "${BOLD}${BLUE}[2/5] Security & Credentials Plane${RESET}"

{{- if .features.use_1password }}
if [ -n "${OP_SSH_AUTH_SOCK:-}" ]; then
    OP_SOCK="$OP_SSH_AUTH_SOCK"
elif [ "$OS_TYPE" = "Darwin" ]; then
    OP_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
else
    OP_SOCK="$HOME/.1password/agent.sock"
fi

if [ -S "$OP_SOCK" ]; then
    check_status "1Password SSH Agent" "pass" "Socket active ($OP_SOCK)"
else
    check_status "1Password SSH Agent" "warn" "Socket not detected ($OP_SOCK)"
fi
{{- end }}

{{- if eq .machine_profile "devcontainer" }}
check_status "Git SSH Signing" "pass" "Disabled by devcontainer profile"
{{- else }}
if [ -f "$HOME/.ssh/keys/git_signing.pub" ]; then
    check_status "Git SSH Signing Key" "pass" "$HOME/.ssh/keys/git_signing.pub ready"
else
    check_status "Git SSH Signing Key" "warn" "Signing public key missing (run chezmoi scripts)"
fi

if [ -f "$HOME/.ssh/allowed_signers" ]; then
    check_status "SSH Allowed Signers" "pass" "$HOME/.ssh/allowed_signers configured"
else
    check_status "SSH Allowed Signers" "warn" "$HOME/.ssh/allowed_signers missing"
fi
{{- end }}

if command -v gitleaks &>/dev/null; then
    GLEAKS_VER="$(gitleaks version 2>/dev/null || echo "installed")"
    check_status "gitleaks Scanner" "pass" "v$GLEAKS_VER"
else
    check_status "gitleaks Scanner" "warn" "gitleaks missing (run brew bundle)"
fi

echo ""

# ------------------------------------------------------------------------------
# 3. Runtime & Platform Toolchain
# ------------------------------------------------------------------------------
echo -e "${BOLD}${BLUE}[3/5] Runtime & Platform Toolchain${RESET}"

if command -v uv &>/dev/null; then
    UV_VER="$(uv --version 2>/dev/null | head -n1 || echo "installed")"
    check_status "uv Python Manager" "pass" "$UV_VER"
else
    check_status "uv Python Manager" "warn" "uv binary missing"
fi

if command -v python3 &>/dev/null; then
    PY_VER="$(python3 --version 2>/dev/null | awk '{print $2}' || echo "installed")"
    check_status "Python Environment" "pass" "v$PY_VER"
else
    check_status "Python Environment" "warn" "Python3 missing"
fi

if command -v node &>/dev/null; then
    NODE_VER="$(node --version 2>/dev/null || echo "installed")"
    check_status "Node.js Environment" "pass" "$NODE_VER"
else
    check_status "Node.js Environment" "warn" "Node.js missing"
fi

if command -v rustc &>/dev/null; then
    RUST_VER="$(rustc --version 2>/dev/null | awk '{print $2}' || echo "installed")"
    check_status "Rust Toolchain" "pass" "v$RUST_VER"
else
    check_status "Rust Toolchain" "warn" "Rust toolchain missing"
fi

if command -v go &>/dev/null; then
    GO_VER="$(go version 2>/dev/null | awk '{print $3}' || echo "installed")"
    check_status "Go Toolchain" "pass" "$GO_VER"
else
    check_status "Go Toolchain" "warn" "Go toolchain missing"
fi

if command -v zig &>/dev/null; then
    ZIG_VER="$(zig version 2>/dev/null || echo "installed")"
    check_status "Zig Toolchain" "pass" "v$ZIG_VER"
else
    check_status "Zig Toolchain" "warn" "Zig toolchain missing"
fi

if command -v clang &>/dev/null; then
    CLANG_VER="$(clang --version 2>/dev/null | head -n1 || echo "installed")"
    check_status "LLVM C/C++ Toolchain" "pass" "$CLANG_VER"
else
    check_status "LLVM C/C++ Toolchain" "warn" "Homebrew LLVM missing"
fi

if command -v cmake &>/dev/null; then
    CMAKE_VER="$(cmake --version 2>/dev/null | head -n1 || echo "installed")"
    check_status "CMake Build System" "pass" "$CMAKE_VER"
else
    check_status "CMake Build System" "warn" "CMake missing"
fi

if command -v ninja &>/dev/null; then
    NINJA_VER="$(ninja --version 2>/dev/null || echo "installed")"
    check_status "Ninja Build Backend" "pass" "v$NINJA_VER"
else
    check_status "Ninja Build Backend" "warn" "Ninja missing"
fi

if command -v ccache &>/dev/null; then
    CCACHE_VER="$(ccache --version 2>/dev/null | head -n1 || echo "installed")"
    check_status "C/C++ Compiler Cache" "pass" "$CCACHE_VER"
else
    check_status "C/C++ Compiler Cache" "warn" "ccache missing"
fi

if command -v cxx &>/dev/null; then
    CXX_INIT_VER="$(cxx --version 2>/dev/null | head -n1 || echo "installed")"
    check_status "C++ Project Initializer" "pass" "$CXX_INIT_VER"
else
    check_status "C++ Project Initializer" "warn" "cxx-init missing (run chezmoi apply)"
fi

if command -v terraform &>/dev/null; then
    TF_VER="$(terraform version -json 2>/dev/null | jq -r '.terraform_version' || echo "installed")"
    check_status "Terraform CLI" "pass" "v$TF_VER"
else
    check_status "Terraform CLI" "warn" "Terraform missing"
fi

if command -v kubectl &>/dev/null; then
    KUBECTL_VER="$(kubectl version --client -o json 2>/dev/null | jq -r '.clientVersion.gitVersion' || echo "installed")"
    check_status "Kubernetes CLI" "pass" "$KUBECTL_VER"
else
    check_status "Kubernetes CLI" "warn" "kubectl missing"
fi

if command -v helm &>/dev/null; then
    HELM_VER="$(helm version --short 2>/dev/null || echo "installed")"
    check_status "Helm CLI" "pass" "$HELM_VER"
else
    check_status "Helm CLI" "warn" "Helm missing"
fi

RUNTIME_SOURCE_OK=true
if [ -z "$BREW_PREFIX" ]; then
    RUNTIME_SOURCE_OK=false
else
    for tool in uv python3 node rustc go zig clang cmake ninja ccache terraform kubectl helm; do
        tool_path="$(command -v "$tool" 2>/dev/null || true)"
        case "$tool_path" in
            "$BREW_PREFIX"/*) ;;
            *) RUNTIME_SOURCE_OK=false ;;
        esac
    done
fi
if [ "$RUNTIME_SOURCE_OK" = true ]; then
    check_status "Runtime Ownership" "pass" "All runtimes resolve from $BREW_PREFIX"
else
    check_status "Runtime Ownership" "warn" "A runtime is outside Homebrew; inspect with 'whence -a <tool>'"
fi

echo ""

# ------------------------------------------------------------------------------
# 4. Productivity & Terminal Environment
# ------------------------------------------------------------------------------
echo -e "${BOLD}${BLUE}[4/5] Productivity & Terminal Suite${RESET}"

for tool in starship atuin zoxide yazi lazygit zellij nvim carapace; do
    if command -v "$tool" &>/dev/null; then
        check_status "$tool" "pass" "installed"
    else
        check_status "$tool" "warn" "missing in PATH"
    fi
done

if [ "$OS_TYPE" = "Darwin" ]; then
    if command -v ghostty &>/dev/null || [ -d "/Applications/Ghostty.app" ] || [ -d "$HOME/Applications/Ghostty.app" ]; then
        check_status "ghostty" "pass" "installed"
    else
        check_status "ghostty" "warn" "application not found"
    fi
fi

echo ""

# ------------------------------------------------------------------------------
# 5. Summary & Health Report
# ------------------------------------------------------------------------------
echo -e "${BOLD}${BLUE}[5/5] Diagnostic Summary${RESET}"
echo -e "  Total Checks : $TOTAL_CHECKS"
echo -e "  Passed       : ${GREEN}$PASSED_CHECKS${RESET}"
echo -e "  Warnings     : ${YELLOW}$WARN_CHECKS${RESET}"
echo -e "  Failures     : ${RED}$FAIL_CHECKS${RESET}"
echo ""

if [ "$FAIL_CHECKS" -eq 0 ] && [ "$WARN_CHECKS" -eq 0 ]; then
    echo -e "${BOLD}${GREEN}🎉 Platform status: 100% Healthy! Environment is in peak DevEx state.${RESET}"
elif [ "$FAIL_CHECKS" -eq 0 ]; then
    echo -e "${BOLD}${YELLOW}⚡ Platform status: Good with minor warnings. Review the items above.${RESET}"
else
    echo -e "${BOLD}${RED}🚨 Platform status: Needs attention. Please fix failed items above.${RESET}"
fi
echo -e "${BOLD}${CYAN}======================================================================${RESET}"

if [ "$FAIL_CHECKS" -gt 0 ]; then
    exit 1
fi
