# ------------------------------------------------------------------------------
# Zsh 环境变量导出配置模板
# 由 chezmoi 托管 | DevSecOps 生产级 Profile
# ------------------------------------------------------------------------------

# 清除从长生命周期终端进程继承的旧工具链覆盖。
unset RUSTFLAGS ZIG_FLAGS CFLAGS CXXFLAGS
unset UV_PYTHON_PREFERENCE ZVM_INSTALL

# --- 1. 默认编辑器与 Pager 分页器 ---
export EDITOR="{{ .git.editor }}"
export VISUAL="{{ .git.editor }}"
export GIT_EDITOR="{{ .git.editor }}"
export SUDO_EDITOR="{{ .git.editor }}"
export SYSTEMD_EDITOR="{{ .git.editor }}"
export KUBE_EDITOR="{{ .git.editor }}"
export FCEDIT="{{ .git.editor }}"
export NVIM_LOG_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/nvim/log"
export PAGER="less -RF"
export LANG="en_US.UTF-8"

# --- 2. 工具链与主题环境变量 ---
export CARGO_HOME="$HOME/.cargo"
export GOPATH="$HOME/go"
export BAT_THEME="Catppuccin Mocha"
export EZA_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/eza"

# --- 3. FZF 配色主题配置 (Catppuccin Mocha 调色板) ---
export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border \
  --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 \
  --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc \
  --color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8"
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {} 2>/dev/null || eza --tree --level=2 --color=always {} 2>/dev/null'"
export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --color=always {} 2>/dev/null'"
# Atuin 独占 Ctrl-R；fzf 只负责 Ctrl-T 与 Alt-C。空值会让 `fzf --zsh` 不创建历史绑定。
export FZF_CTRL_R_COMMAND=""
