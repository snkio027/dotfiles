// ------------------------------------------------------------------------------
// Zellij 终端工作区复用器配置文件
// DevSecOps 生产级 Profile | 默认锁定，避免吞掉 Shell/编辑器快捷键
// ------------------------------------------------------------------------------

theme "catppuccin-mocha"
default_layout "compact"
mouse_mode true
copy_on_select true
pane_frames true
simplified_ui false
default_mode "locked"
session_serialization true
pane_viewport_serialization true
scroll_buffer_size 50000

ui {
    pane_frames {
        rounded_corners true
        hide_session_name false
    }
}

// 嵌合式 Catppuccin Mocha 主题调色板
themes {
    catppuccin-mocha {
        bg "#585b70"
        fg "#cdd6f4"
        red "#f38ba8"
        green "#a6e3a1"
        yellow "#f9e2af"
        blue "#89b4fa"
        magenta "#cba6f7"
        cyan "#94e2d5"
        white "#bac2de"
        orange "#fab387"
        black "#181825"
    }
}
