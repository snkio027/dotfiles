# ==============================================================================
# ~/.ssh/config — SSH 客户端配置文件模板
# 由 chezmoi 托管 | 自动应用严格安全权限 (600)
# ==============================================================================

# 模块化 Host 独立配置文件引用 (包含 GitHub、GitLab、内网基础设施等)
Include ~/.ssh/config.d/*.conf

Host *
{{- if and .is_mac (eq .machine_profile "workstation") }}
    IdentityAgent {{ joinPath .chezmoi.homeDir ".ssh/proton-pass-ssh-agent.sock" | quote }}
{{- else }}
    AddKeysToAgent yes
{{- if .is_mac }}
    UseKeychain yes
{{- end }}
{{- end }}
    ServerAliveInterval 60
    ServerAliveCountMax 10
