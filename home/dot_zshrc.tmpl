# ------------------------------------------------------------------------------
# ~/.zshrc — Zsh Shell 交互终端入口配置模板
# 由 chezmoi 托管 | DevSecOps 生产级 Profile
# ------------------------------------------------------------------------------

# macOS GUI 终端可能继承 256 的软上限，clangd 读取标准库时会耗尽文件句柄。
# 只调整本 Shell 及其后代；保留更高值、不改变硬上限、不修改 launchd/sysctl。
if [[ "$OSTYPE" == darwin* ]]; then
    () {
        local soft_limit hard_limit target_limit=4096
        soft_limit="$(ulimit -Sn)" || return 0
        [[ "$soft_limit" != unlimited ]] || return 0
        (( soft_limit < target_limit )) || return 0
        hard_limit="$(ulimit -Hn)" || return 0
        if [[ "$hard_limit" != unlimited ]] && (( hard_limit < target_limit )); then
            target_limit=$hard_limit
        fi
        (( target_limit > soft_limit )) || return 0
        ulimit -Sn "$target_limit" || print -u2 -- 'zsh: 无法提高文件句柄软上限；clangd 可能耗尽句柄。'
    }
fi

# --- 1. 加载 Shell 模块化子配置（环境、别名、补全）---
ZSH_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"

if [ -d "$ZSH_CONFIG_DIR" ]; then
    # 非登录交互 Shell（终端新标签、Zellij Pane）不会读取 .zprofile。
    [ -f "$ZSH_CONFIG_DIR/homebrew.zsh" ] && source "$ZSH_CONFIG_DIR/homebrew.zsh"
    [ -f "$ZSH_CONFIG_DIR/exports.zsh" ] && source "$ZSH_CONFIG_DIR/exports.zsh"
    [ -f "$ZSH_CONFIG_DIR/aliases.zsh" ] && source "$ZSH_CONFIG_DIR/aliases.zsh"
    [ -f "$ZSH_CONFIG_DIR/plugins.zsh" ] && source "$ZSH_CONFIG_DIR/plugins.zsh"
fi

# --- 2. 交互式工具钩子 ---
# 每次按当前 PATH、参数与环境生成；Atuin 配置和 Carapace 配置路径也可能改变输出。

if command -v direnv &>/dev/null; then
    builtin source <(command direnv hook zsh)
fi

if command -v fzf &>/dev/null; then
    builtin source <(command fzf --zsh)
fi

{{- if .features.use_atuin }}
# Atuin 在 fzf 之后加载，即使上游 fzf 行为改变，Ctrl-R 的最终所有者仍是 Atuin。
if command -v atuin &>/dev/null; then
    builtin source <(command atuin init zsh --disable-up-arrow)
fi
{{- end }}

if command -v zoxide &>/dev/null; then
    builtin source <(command zoxide init zsh)
fi

if command -v carapace &>/dev/null; then
    export CARAPACE_BRIDGES='zsh,fish,bash'
    builtin source <(command carapace _carapace zsh)
fi

{{- if .features.use_starship }}
if command -v starship &>/dev/null; then
    builtin source <(command starship init zsh)
fi
{{- end }}

# zsh-autosuggestions 自动补全建议插件
if [[ -n "${HOMEBREW_PREFIX:-}" && -f "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
    source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# zsh-syntax-highlighting 命令行语法高亮插件 (须在末尾挂载)
if [[ -n "${HOMEBREW_PREFIX:-}" && -f "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
    source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
