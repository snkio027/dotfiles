#!/usr/bin/env bash
# Missing-only setup after Brew; never update an existing vcpkg checkout.
# Provisioner: {{ include "../scripts/cpp/provision-vcpkg.sh" | sha256sum }}
set -euo pipefail
{{- if .is_mac }}
{{-   if .is_arm64 }}
BREW_PREFIX="/opt/homebrew"
{{-   else }}
BREW_PREFIX="/usr/local"
{{-   end }}
{{- else if .is_linux }}
BREW_PREFIX="/home/linuxbrew/.linuxbrew"
{{- else }}
{{-   fail (printf "unsupported vcpkg platform: %s/%s" .chezmoi.os .chezmoi.arch) }}
{{- end }}
bash "{{ .chezmoi.workingTree }}/scripts/cpp/provision-vcpkg.sh" "$BREW_PREFIX"
