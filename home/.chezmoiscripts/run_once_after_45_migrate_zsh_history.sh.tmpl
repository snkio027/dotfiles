#!/usr/bin/env bash
# ------------------------------------------------------------------------------
# 旧版的自动迁移已停用。旧 Shell 的 HIST_SAVE_BY_COPY 会用普通文件
# 替换兼容 symlink，导致历史分流；不能在仍有会话运行时安全搬移或合并。
# plugins.zsh 为已有历史选择兼容路径，新安装仍使用 XDG state。
# ------------------------------------------------------------------------------

set -euo pipefail

LEGACY_HISTORY="$HOME/.zsh_history"

if [ -e "$LEGACY_HISTORY" ] || [ -L "$LEGACY_HISTORY" ]; then
    echo "ℹ️  保留 $LEGACY_HISTORY；历史自动迁移已停用，请重启旧 Shell。"
fi
