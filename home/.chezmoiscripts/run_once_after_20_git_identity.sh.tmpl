#!/usr/bin/env bash
# ------------------------------------------------------------------------------
# run_once_after_20_git_identity.sh.tmpl
# 开发者信任链身份自动化初始化脚本 (整合原 Developer Trust 全流程)
# 由 chezmoi 托管 | 自动完成 Ed25519 秘钥生成、GitHub 注册与信任链配置
# ------------------------------------------------------------------------------

set -euo pipefail

{{- if eq (index . "machine_profile") "devcontainer" }}
echo "ℹ️  DevContainer 继承宿主凭据，跳过密钥生成与远端注册。"
exit 0
{{- end }}

{{- if .features.use_1password }}
SIGN_PUB="$HOME/.ssh/keys/git_signing.pub"
OP_SSH_SOCKET={{ .op_ssh_socket | quote }}
if [ ! -r "$SIGN_PUB" ]; then
    echo "✘ 1Password 签名公钥不可读: $SIGN_PUB" >&2
    echo "  请导出所选 1Password SSH key 的公钥后重新运行 chezmoi apply。" >&2
    exit 1
fi
EXPECTED_SIGNING_KEY="$(awk 'NF >= 2 { print $1 " " $2; exit }' "$SIGN_PUB")"

if [ ! -S "$OP_SSH_SOCKET" ]; then
    echo "✘ 1Password SSH Agent socket 不可用: $OP_SSH_SOCKET" >&2
    echo "  请在 1Password 中启用 SSH Agent，或关闭 features.use_1password。" >&2
    exit 1
fi
if [ -z "$EXPECTED_SIGNING_KEY" ]; then
    echo "✘ 无法读取 1Password 签名公钥: $SIGN_PUB" >&2
    echo "  请重新导出所选 1Password SSH key 的公钥后运行 chezmoi apply。" >&2
    exit 1
fi
if ! SSH_AUTH_SOCK="$OP_SSH_SOCKET" ssh-add -L 2>/dev/null | awk -v expected="$EXPECTED_SIGNING_KEY" '
    ($1 " " $2) == expected { found = 1 }
    END { exit !found }
'; then
    echo "✘ 导出的签名公钥未由当前 1Password SSH Agent 提供。" >&2
    echo "  请在 Agent 中启用同一 key，或重新导出 ~/.ssh/keys/git_signing.pub。" >&2
    exit 1
fi

echo "ℹ️  1Password SSH Agent 与 Git 签名公钥匹配，不生成磁盘私钥。"
exit 0
{{- end }}

{{- if .is_mac }}
{{-   if .is_arm64 }}
GH_BIN="/opt/homebrew/bin/gh"
{{-   else }}
GH_BIN="/usr/local/bin/gh"
{{-   end }}
{{- else if .is_linux }}
GH_BIN="/home/linuxbrew/.linuxbrew/bin/gh"
{{- else }}
{{-   fail (printf "unsupported GitHub CLI platform: %s/%s" .chezmoi.os .chezmoi.arch) }}
{{- end }}

KEY_DIR="$HOME/.ssh/keys"
AUTH_KEY="$KEY_DIR/github_auth"
SIGN_KEY="$KEY_DIR/git_signing"
AUTH_PUB="${AUTH_KEY}.pub"
SIGN_PUB="${SIGN_KEY}.pub"

if { [ ! -f "$AUTH_KEY" ] || [ ! -f "$SIGN_KEY" ]; } && [ ! -t 0 ]; then
    echo "✘ 缺少本地 SSH key，非交互环境不会启动 ssh-keygen。" >&2
    echo "  请在终端运行 chezmoi apply 并设置非空口令，或启用 1Password Profile。" >&2
    exit 1
fi

generate_protected_key() {
    local key_path="$1"
    local purpose="$2"

    echo "  ▶ 正在生成 Ed25519 ${purpose}（必须设置非空口令）..."
    ssh-keygen -t ed25519 -a 100 -C "{{ .email }}" -f "$key_path"
    if ssh-keygen -y -P "" -f "$key_path" >/dev/null 2>&1; then
        rm -f -- "$key_path" "${key_path}.pub"
        echo "    ✘ 不接受空口令；已删除刚生成的 key，请重新运行 chezmoi apply。" >&2
        return 1
    fi
}

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  🔑  Git 开发者信任链 — 身份自动化初始化"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# 1. 确保私钥存放目录存在且具有 700 严格安全权限
mkdir -p "$KEY_DIR"
chmod 700 "$HOME/.ssh" "$KEY_DIR"

# 2. 若不存在则自动生成 Ed25519 SSH 认证私钥
if [ ! -f "$AUTH_KEY" ]; then
    generate_protected_key "$AUTH_KEY" "SSH 认证 key"
    chmod 600 "$AUTH_KEY"
    chmod 644 "$AUTH_PUB"
    echo "    ✔ 成功创建: $AUTH_KEY"
else
    echo "  ✔ 认证秘钥就绪: $AUTH_KEY"
fi

# 3. 若不存在则自动生成 Ed25519 Git 提交签名秘钥
if [ ! -f "$SIGN_KEY" ]; then
    generate_protected_key "$SIGN_KEY" "Git 提交签名 key"
    chmod 600 "$SIGN_KEY"
    chmod 644 "$SIGN_PUB"
    echo "    ✔ 成功创建: $SIGN_KEY"
else
    echo "  ✔ 提交签名秘钥就绪: $SIGN_KEY"
fi

# 4. 更新 ~/.ssh/allowed_signers 信任链文件
ALLOWED_SIGNERS="$HOME/.ssh/allowed_signers"
if [ -f "$SIGN_PUB" ]; then
    SIGN_PUB_CONTENT=$(cat "$SIGN_PUB")
    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"
    if ! grep -Fq "$SIGN_PUB_CONTENT" "$ALLOWED_SIGNERS" 2>/dev/null; then
        echo "{{ .email }} $SIGN_PUB_CONTENT" >>"$ALLOWED_SIGNERS"
        chmod 600 "$ALLOWED_SIGNERS"
        echo "  ✔ 成功注册签名秘钥至 ~/.ssh/allowed_signers"
    fi
fi

# 5. 通过 Brew 管理的 GitHub CLI 自动完成远端秘钥注册。
# Brew bundle 无法修改父进程 PATH，因此消费者必须使用确定入口。
if [ ! -x "$GH_BIN" ]; then
    echo "✘ Brew 管理的 gh 入口缺失或不可执行: $GH_BIN" >&2
    exit 1
fi
if GH_HOST=github.com "$GH_BIN" --version >/dev/null; then
    :
else
    status=$?
    echo "✘ Brew 管理的 gh 入口无法正常执行: $GH_BIN" >&2
    exit "$status"
fi

WORKSTATION_HOSTNAME=$(hostname -s 2>/dev/null || echo "workstation")
if GH_HOST=github.com "$GH_BIN" auth status --active --hostname github.com &>/dev/null; then
    echo "  ▶ 正在通过 GitHub CLI 将秘钥绑定至 GitHub 账户..."

    # 绑定 SSH 认证秘钥
    AUTH_MATERIAL="$(awk '{print $1 " " $2}' "$AUTH_PUB")"
    if AUTH_REMOTE_KEYS="$(GH_HOST=github.com "$GH_BIN" api --hostname github.com --paginate user/keys --jq '.[].key')"; then
        :
    else
        status=$?
        echo "    ✘ 无法查询 github.com 认证公钥；本次同步未完成。" >&2
        exit "$status"
    fi
    if printf '%s\n' "$AUTH_REMOTE_KEYS" | grep -Fqx "$AUTH_MATERIAL"; then
        echo "    ✔ 认证秘钥已在 GitHub 注册"
    else
        if GH_HOST=github.com "$GH_BIN" ssh-key add "$AUTH_PUB" --title "$WORKSTATION_HOSTNAME-auth-key"; then
            echo "    ✔ 成功注册认证秘钥至 GitHub"
        else
            status=$?
            echo "    ✘ 认证公钥上传失败；本次同步未完成。" >&2
            exit "$status"
        fi
    fi

    # 绑定 Git 提交签名秘钥
    SIGN_MATERIAL="$(awk '{print $1 " " $2}' "$SIGN_PUB")"
    if SIGN_REMOTE_KEYS="$(GH_HOST=github.com "$GH_BIN" api --hostname github.com --paginate user/ssh_signing_keys --jq '.[].key')"; then
        :
    else
        status=$?
        echo "    ✘ 无法查询 github.com 签名公钥；本次同步未完成。" >&2
        exit "$status"
    fi
    if printf '%s\n' "$SIGN_REMOTE_KEYS" | grep -Fqx "$SIGN_MATERIAL"; then
        echo "    ✔ 签名秘钥已在 GitHub 注册"
    else
        if GH_HOST=github.com "$GH_BIN" ssh-key add "$SIGN_PUB" --type signing --title "$WORKSTATION_HOSTNAME-signing-key"; then
            echo "    ✔ 成功注册签名秘钥至 GitHub"
        else
            status=$?
            echo "    ✘ 签名公钥上传失败；本次同步未完成。" >&2
            exit "$status"
        fi
    fi
else
    echo "  ℹ  github.com 当前未认证；本次未同步远端公钥。"
    echo "     该 run_once 脚本不会在后续 apply 中自动重试。请显式执行:"
    printf '     GH_HOST=github.com %q auth login --hostname github.com --scopes admin:public_key,admin:ssh_signing_key --skip-ssh-key\n' "$GH_BIN"
    printf '     GH_HOST=github.com %q ssh-key add %q --title %q\n' \
        "$GH_BIN" "$AUTH_PUB" "$WORKSTATION_HOSTNAME-auth-key"
    printf '     GH_HOST=github.com %q ssh-key add %q --type signing --title %q\n' \
        "$GH_BIN" "$SIGN_PUB" "$WORKSTATION_HOSTNAME-signing-key"
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  ✔ 开发者信任链身份配置完成。"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
