#!/usr/bin/env bash
# ------------------------------------------------------------------------------
# run_once_after_20_git_identity.sh.tmpl
# 开发者信任链身份自动化初始化脚本 (整合原 Developer Trust 全流程)
# 由 chezmoi 托管 | 自动完成 Ed25519 秘钥生成、GitHub 注册与信任链配置
# ------------------------------------------------------------------------------

set -euo pipefail

{{- if eq (index . "machine_profile") "devcontainer" }}
echo "ℹ️  DevContainer 继承宿主凭据，跳过密钥生成与远端注册。"
exit 0
{{- end }}

KEY_DIR="$HOME/.ssh/keys"
AUTH_KEY="$KEY_DIR/github_auth"
SIGN_KEY="$KEY_DIR/git_signing"
AUTH_PUB="${AUTH_KEY}.pub"
SIGN_PUB="${SIGN_KEY}.pub"

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  🔑  Git 开发者信任链 — 身份自动化初始化"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# 1. 确保私钥存放目录存在且具有 700 严格安全权限
mkdir -p "$KEY_DIR"
chmod 700 "$HOME/.ssh" "$KEY_DIR"

# 2. 若不存在则自动生成 Ed25519 SSH 认证私钥
if [ ! -f "$AUTH_KEY" ]; then
    echo "  ▶ 正在生成 Ed25519 SSH 认证秘钥..."
    ssh-keygen -t ed25519 -C "{{ .email }}" -N "" -f "$AUTH_KEY" >/dev/null
    chmod 600 "$AUTH_KEY"
    chmod 644 "$AUTH_PUB"
    echo "    ✔ 成功创建: $AUTH_KEY"
else
    echo "  ✔ 认证秘钥就绪: $AUTH_KEY"
fi

# 3. 若不存在则自动生成 Ed25519 Git 提交签名秘钥
if [ ! -f "$SIGN_KEY" ]; then
    echo "  ▶ 正在生成 Ed25519 Git 提交签名秘钥..."
    ssh-keygen -t ed25519 -C "{{ .email }}" -N "" -f "$SIGN_KEY" >/dev/null
    chmod 600 "$SIGN_KEY"
    chmod 644 "$SIGN_PUB"
    echo "    ✔ 成功创建: $SIGN_KEY"
else
    echo "  ✔ 提交签名秘钥就绪: $SIGN_KEY"
fi

# 4. 更新 ~/.ssh/allowed_signers 信任链文件
ALLOWED_SIGNERS="$HOME/.ssh/allowed_signers"
if [ -f "$SIGN_PUB" ]; then
    SIGN_PUB_CONTENT=$(cat "$SIGN_PUB")
    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"
    if ! grep -Fq "$SIGN_PUB_CONTENT" "$ALLOWED_SIGNERS" 2>/dev/null; then
        echo "{{ .email }} $SIGN_PUB_CONTENT" >>"$ALLOWED_SIGNERS"
        chmod 600 "$ALLOWED_SIGNERS"
        echo "  ✔ 成功注册签名秘钥至 ~/.ssh/allowed_signers"
    fi
fi

# 5. 通过 GitHub CLI (gh) 自动完成远端秘钥注册
if command -v gh &>/dev/null; then
    if gh auth status &>/dev/null; then
        HOSTNAME=$(hostname -s 2>/dev/null || echo "workstation")
        echo "  ▶ 正在通过 GitHub CLI 将秘钥绑定至 GitHub 账户..."

        # 绑定 SSH 认证秘钥
        AUTH_MATERIAL="$(awk '{print $1 " " $2}' "$AUTH_PUB")"
        if ! gh api --paginate user/keys --jq '.[].key' 2>/dev/null | grep -Fqx "$AUTH_MATERIAL"; then
            if ! gh ssh-key add "$AUTH_PUB" --title "$HOSTNAME-auth-key" 2>/dev/null; then
                echo "    ⚠️ 认证秘钥自动绑定失败 (执行: gh auth refresh -h github.com -s admin:public_key)"
            else
                echo "    ✔ 成功注册认证秘钥至 GitHub"
            fi
        else
            echo "    ✔ 认证秘钥已在 GitHub 注册"
        fi

        # 绑定 Git 提交签名秘钥
        SIGN_MATERIAL="$(awk '{print $1 " " $2}' "$SIGN_PUB")"
        if ! gh api --paginate user/ssh_signing_keys --jq '.[].key' 2>/dev/null | grep -Fqx "$SIGN_MATERIAL"; then
            if ! gh ssh-key add "$SIGN_PUB" --type signing --title "$HOSTNAME-signing-key" 2>/dev/null; then
                echo "    ⚠️ 签名秘钥自动绑定失败 (执行: gh auth refresh -h github.com -s admin:ssh_signing_key)"
            else
                echo "    ✔ 成功注册签名秘钥至 GitHub"
            fi
        else
            echo "    ✔ 签名秘钥已在 GitHub 注册"
        fi
    else
        echo "  ℹ  检测到 gh CLI 但未登录，运行 'gh auth login' 后可自动同步远端秘钥。"
    fi
else
    echo "  ℹ  未安装 gh CLI，请手动将以下公钥添加至 GitHub Settings → SSH Keys:"
    echo "     认证公钥路径 : $AUTH_PUB"
    echo "     签名公钥路径 : $SIGN_PUB"
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  ✔ 开发者信任链身份配置完成。"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
