# ------------------------------------------------------------------------------
# ~/.zprofile — 登录 Shell 环境
# 只放每个登录会话执行一次的初始化，避免拖慢每个交互式 Zsh。
# ------------------------------------------------------------------------------

ZSH_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"

# 登录与交互 Shell 共享同一个 Homebrew 环境所有者。
[[ -r "$ZSH_CONFIG_DIR/homebrew.zsh" ]] && source "$ZSH_CONFIG_DIR/homebrew.zsh"

unset ZSH_CONFIG_DIR
