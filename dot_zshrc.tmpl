# ------------------------------------------------------------------------------
# ~/.zshrc — Zsh Shell 交互终端入口配置模板
# 由 chezmoi 托管 | DevSecOps 生产级 Profile
# ------------------------------------------------------------------------------

# --- 0. Homebrew 软件包管理器环境挂载 ---
{{- if .is_mac }}
if [ -x "/opt/homebrew/bin/brew" ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi
{{- else if .is_linux }}
if [ -x "/home/linuxbrew/.linuxbrew/bin/brew" ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi
{{- end }}

# --- 1. 加载 Shell 模块化子配置 (环境变量与别名) ---
ZSH_CONFIG_DIR="$HOME/.config/zsh"

if [ -d "$ZSH_CONFIG_DIR" ]; then
    [ -f "$ZSH_CONFIG_DIR/exports.zsh" ] && source "$ZSH_CONFIG_DIR/exports.zsh"
    [ -f "$ZSH_CONFIG_DIR/aliases.zsh" ] && source "$ZSH_CONFIG_DIR/aliases.zsh"
fi

# --- 2. Zinit 插件管理器初始化 ---
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
if [ -d "$ZINIT_HOME" ]; then
    source "${ZINIT_HOME}/zinit.zsh"
fi

# --- 3. 交互式 Shell 工具钩子与行编辑器 (ZLE) 挂载 ---

# direnv 目录环境变量自动切换钩子
if command -v direnv &>/dev/null; then
    eval "$(direnv hook zsh)"
fi

# Atuin 加密 Shell 历史数据库初始化
# --disable-up-arrow: 防止 Atuin 接管方向键，避免与 Starship 多行提示符的 ZLE hook 冲突导致双重渲染
if command -v atuin &>/dev/null; then
    eval "$(atuin init zsh --disable-up-arrow)"
fi

# FZF 命令行模糊搜索集成 (fzf ≥0.48 统一入口，已废弃旧 Homebrew key-bindings.zsh 分开挂载)
if command -v fzf &>/dev/null; then
    eval "$(fzf --zsh 2>/dev/null || true)"
fi

# 挂载 Zsh 插件与 Starship Transient Prompt 瞬时提示符
if [ -d "$ZSH_CONFIG_DIR" ] && [ -f "$ZSH_CONFIG_DIR/plugins.zsh" ]; then
    source "$ZSH_CONFIG_DIR/plugins.zsh"
fi

# zsh-autosuggestions 自动补全建议插件
if [ -f "${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then
    source "${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# zsh-syntax-highlighting 命令行语法高亮插件 (须在末尾挂载)
if [ -f "${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]; then
    source "${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
