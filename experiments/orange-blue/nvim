#!/usr/bin/env bash
set -euo pipefail

preview_dir="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source_config="${XDG_CONFIG_HOME:-$HOME/.config}"
[[ -f "$source_config/nvim/init.lua" ]] || {
    echo "Daily Neovim config is missing: $source_config/nvim" >&2
    exit 1
}
run_dir="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-orange-blue.XXXXXX")"
mkdir -p "$run_dir/config" "$run_dir/state" "$run_dir/cache"
cp -RL "$source_config/nvim" "$run_dir/config/nvim"
for companion in neocmakelsp markdownlint-cli2; do
    if [[ -d "$source_config/$companion" ]]; then
        cp -RL "$source_config/$companion" "$run_dir/config/$companion"
    fi
done

# Share installed plugins/Mason; isolate config, compiled colors, state and logs.
export DOTFILES_COLOR_PREVIEW_DIR="$preview_dir"
export DOTFILES_COLOR_BASELINE_CONFIG="$source_config/nvim"
export XDG_CONFIG_HOME="$run_dir/config"
export XDG_STATE_HOME="$run_dir/state"
export XDG_CACHE_HOME="$run_dir/cache"
export NVIM_APPNAME=nvim
export NVIM_LOG_FILE="$run_dir/state/nvim.log"
exec nvim -n -i NONE --cmd \
    'lua vim.opt.rtp:prepend(vim.fn.stdpath("config")); dofile(vim.env.DOTFILES_COLOR_PREVIEW_DIR .. "/preview.lua")' "$@"
